# OpenAI option
OPENAI_API_KEY=
OPENAI_MODEL=

# Local Ollama option (used only when OPENAI_API_KEY is empty)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b

# Stable conversation identity. Use a different value for a separate conversation.
PAYMENT_PLANNER_SESSION_ID=payment-planner:default:thread-01

# OpenAI Responses model used to summarize old session history.
COMPACTION_MODEL=gpt-4.1

# Optional observability. Traces stay local unless main.py is run with --langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development
