# Copy to .env; never commit the filled file.
PAYMENT_PLANNER_MODE=fixture
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAYMENT_PLANNER_ACCESS_TOKEN=
PAYMENT_PLANNER_USER_ID=owner
OPENAI_API_KEY=
PAYMENT_PLANNER_MODEL=gpt-4.1-mini
PAYMENT_PLANNER_TIMEOUT_SECONDS=60
PAYMENT_PLANNER_MAX_TURNS=8
PAYMENT_PLANNER_MAX_OUTPUT_TOKENS=1200
PAYMENT_PLANNER_REQUESTS_PER_MINUTE=20
PAYMENT_PLANNER_COMPACTION=false
PAYMENT_PLANNER_LANGFUSE=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
